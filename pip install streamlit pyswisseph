if mode == "Transit-Scan im Zeitfenster":
    st.subheader("📅 Zeitfenster-Scan")
    
    col1, col2 = st.columns(2)
    with col1:
        start_date = st.date_input("Startdatum", datetime.date.today())
    with col2:
        end_date = st.date_input("Enddatum", datetime.date.today() + datetime.timedelta(days=90))
        
    if st.button("Transite simulieren", type="primary"):
        st.divider()
        found_transits = []
        
        # Scan day by day
        curr_d = start_date
        while curr_d <= end_date:
            curr_dt = datetime.datetime.combine(curr_d, datetime.time(12, 0))
            t_pos = calculate_positions(curr_dt)
            
            for t_planet, t_deg in t_pos.items():
                if not include_moon and t_planet == "Mond":
                    continue
                
                for r_planet, r_deg in radix_pos.items():
                    if t_planet == r_planet and t_planet in ["Sonne", "Mond", "Merkur", "Venus", "Mars"]:
                        continue # Skip exact transit-to-same-natal inner planet noise
                    
                    diff = abs(t_deg - r_deg) % 360
                    if diff > 180:
                        diff = 360 - diff
                        
                    for aspect_name, asp_info in ASPECTS.items():
                        if abs(diff - asp_info["angle"]) <= 1.0: # Tight orb trigger
                            h_num = get_house_for_degree(t_deg, radix_cusps)
                            found_transits.append({
                                "date": curr_d,
                                "t_planet": t_planet,
                                "aspect": aspect_name,
                                "symbol": asp_info["symbol"],
                                "r_planet": r_planet,
                                "house": h_num,
                                "orb": abs(diff - asp_info["angle"])
                            })
            curr_d += datetime.timedelta(days=2) # 2-day step for performance

        if not found_transits:
            st.info("In diesem Zeitfenster wurden keine exakten Major-Transite gefunden.")
        else:
            st.success(f"{len(found_transits)} bedeutsame Transit-Konstellationen identifiziert.")
            
            # Synthese-Prognose
