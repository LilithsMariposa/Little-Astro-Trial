# Helper calculations
def get_zodiac_position(degree):
    sign_idx = int(degree // 30)
    deg_in_sign = degree % 30
    return f"{int(deg_in_sign)}° {ZODIAC_SIGNS[sign_idx]}"

def calculate_positions(dt_utc):
    jd = swe.julday(dt_utc.year, dt_utc.month, dt_utc.day, dt_utc.hour + dt_utc.minute/60.0)
    pos = {}
    for p_name, p_id in PLANETS.items():
        res, _ = swe.calc_ut(jd, p_id)
        pos[p_name] = res[0]
    return pos

def calculate_houses(dt_utc, lat, lon):
    jd = swe.julday(dt_utc.year, dt_utc.month, dt_utc.day, dt_utc.hour + dt_utc.minute/60.0)
    cusps, ascmc = swe.houses(jd, lat, lon, b'P')
    return cusps

def get_house_for_degree(degree, cusps):
    for i in range(12):
        c_start = cusps[i]
        c_end = cusps[(i + 1) % 12]
        if c_start < c_end:
            if c_start <= degree < c_end:
                return i + 1
        else: # House spans across 0° Aries
            if degree >= c_start or degree < c_end:
                return i + 1
    return 1

